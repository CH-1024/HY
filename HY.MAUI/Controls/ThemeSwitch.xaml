<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HY.MAUI.Controls.ThemeSwitch">

    <Grid ColumnDefinitions="Auto,Auto,Auto" HorizontalOptions="Center" VerticalOptions="Center">

        <Label x:Name="DarkLabel"
               Grid.Column="0"
               Text="Dark"
               MinimumWidthRequest="0"
               WidthRequest="48"
               VerticalOptions="Center" />

        <Switch x:Name="ThemeSwitchControl"
                Grid.Column="1"
                Margin="0"
                MinimumWidthRequest="0"
                WidthRequest="52"
                VerticalOptions="Center"
                Scale="1.5"
                Toggled="OnToggled" />

        <Label x:Name="LightLabel"
               Grid.Column="2"
               Text="Light"
               MinimumWidthRequest="0"
               VerticalOptions="Center" />

    </Grid>
</ContentView>
